# Local API only (docker-compose.debug-api.yml → :8888)
# Apply:  .\scripts\set-dev-mode.ps1 -Mode local-api

DEV_MODE=local-api
VITE_DEV_TARGET=local

VITE_API_BASE_URL=/api/v1
VITE_ADMIN_API_BASE_URL=/api/v1
VITE_FRONT_BASE_URL=http://127.0.0.1:5175

ADMIN_API_PROXY_TARGET=http://127.0.0.1:8888
FRONT_API_PROXY_TARGET=http://127.0.0.1:8888
