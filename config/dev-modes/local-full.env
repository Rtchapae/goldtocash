# Full local stack (docker-compose.local-full.yml → site :9080)
# Apply:  .\scripts\set-dev-mode.ps1 -Mode local-full

DEV_MODE=local-full
VITE_DEV_TARGET=local

VITE_API_BASE_URL=/api/v1
VITE_ADMIN_API_BASE_URL=/api/v1
VITE_FRONT_BASE_URL=http://127.0.0.1:9080

ADMIN_API_PROXY_TARGET=http://127.0.0.1:9080
FRONT_API_PROXY_TARGET=http://127.0.0.1:9080
