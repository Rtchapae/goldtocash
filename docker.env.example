# Environment Configuration for Docker Compose
# Copy this file to docker.env and fill in your values

# Application Environment
NODE_ENV=production

# API Configuration
VITE_API_PROTOCOL=https
VITE_API_HOST=https://goldtocash.us
VITE_API_PORT=443
VITE_API_BASE_URL=https://goldtocash.us/api/v1

# Admin API Configuration
VITE_ADMIN_API_URL=https://goldtocash.us/api/v1

# Frontend URLs
VITE_FRONT_URL=https://goldtocash.us
VITE_ADMIN_URL=https://m.goldtocash.us

# Database Configuration (used by docker-compose)
MYSQL_DATABASE=goldtocash
MYSQL_USER=goldtocash_user
MYSQL_PASSWORD=your_password
MYSQL_ROOT_PASSWORD=root_password
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=goldtocash
DB_USERNAME=goldtocash_user
DB_PASSWORD=your_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (generate: php artisan key:generate --show)
JWT_SECRET=your_jwt_secret
JWT_ALGO=HS256

# Application Keys
APP_NAME="Gold To Cash"
APP_ENV=production
APP_KEY=base64:your_app_key
APP_DEBUG=false
APP_URL=https://goldtocash.us
ADMIN_APP_URL=https://m.goldtocash.us

# Cache Configuration
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis

# Mail (SendGrid)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=465
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=hello@goldtocash.us
MAIL_FROM_NAME="${APP_NAME}"

# FedEx
FEDEX_MODE_PROD=true
FEDEX_REST_KEY_SAND=your_fedex_key
FEDEX_REST_PASSWORD_SAND=your_fedex_password
FEDEX_ACCOUNT_NUMBER_SAND=your_account
FEDEX_METER_NUMBER_SAND=your_meter
FEDEX_REST_KEY_PROD=your_fedex_key
FEDEX_REST_PASSWORD_PROD=your_fedex_password
FEDEX_ACCOUNT_NUMBER_PROD=your_account
FEDEX_METER_NUMBER_PROD=your_meter

# Twilio SMS
SMS_TWILIO_SID=your_twilio_sid
SMS_TWILIO_TOKEN=your_twilio_token
SMS_TWILIO_FROM=your_phone_number

# Other services
SMS_FRAUD_DETECTOR_LOOKUP_ENDPOINT=
SMS_FRAUD_DETECTOR_SECRET=
CUSTOMER_DOT_IO_SITE_ID=
CUSTOMER_DOT_IO_API_KEY=
METALPRICE_API_KEY=
GOOGLE_API_KEY=

# Log Configuration
LOG_CHANNEL=stack
LOG_LEVEL=debug
